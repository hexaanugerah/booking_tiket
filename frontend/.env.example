[TEMPLATE]
# Frontend Environment Variables
# Kalau aplikasi dibuka dari HP di jaringan yang sama, ganti localhost dengan
# IP LAN komputer (lihat `ipconfig`), mis. http://192.168.1.5:8080/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Origin backend untuk proxy runtime (/api/v1 dan /uploads). Dibaca route
# handler saat request, jadi di Cloudflare Workers nilainya diatur lewat
# wrangler.jsonc (vars) atau `npx wrangler secret put BACKEND_ORIGIN`.
BACKEND_ORIGIN=http://localhost:8080

# Untuk Vercel, tambahkan kedua nilai ini di Project Settings > Environment Variables:
# NEXT_PUBLIC_API_BASE_URL=https://<railway-domain>/api/v1
# BACKEND_ORIGIN=https://<railway-domain>
