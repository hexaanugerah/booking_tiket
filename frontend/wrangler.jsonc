// Konfigurasi Cloudflare Workers untuk frontend Next.js (adapter OpenNext).
// Build:  npm run cf:build
// Preview lokal: npm run cf:preview
// Deploy: npm run cf:deploy
{
  "main": ".open-next/worker.js",
  "name": "kawahputih",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Origin backend Go (tanpa /api/v1). Dibaca SAAT REQUEST oleh route handler
  // /api/v1/[...path] dan /uploads/[...path], jadi mengganti nilainya tidak
  // memerlukan build ulang Next.js.
  //
  // Isi dengan URL HTTPS publik backend, mis. https://api.kawahputih.id.
  // Nilai kosong membuat proxy mengembalikan 503 dengan pesan konfigurasi.
  // Alternatif tanpa mengubah file ini:
  //   npx wrangler secret put BACKEND_ORIGIN
  "vars": {
    "BACKEND_ORIGIN": ""
  },
  "observability": {
    "enabled": true
  }
}
