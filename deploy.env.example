# =============================================================================
# Konfigurasi untuk scripts/deploy-server.sh
#
# Salin file ini menjadi deploy.env (tidak ikut git), lalu jalankan:
#   sudo bash scripts/deploy-server.sh
#
# Semua nilai kosong akan dibuat otomatis oleh skrip.
# =============================================================================

# --- Domain & HTTPS ----------------------------------------------------------
# Kosongkan DOMAIN untuk mengakses aplikasi lewat IP server (tanpa domain,
# tanpa perlu mengatur DNS). Isi DOMAIN bila ingin memakai domain.
# Contoh untuk server sekolah:
# DOMAIN=server.smkbudibakti.sch.id
# ENABLE_HTTPS=true
DOMAIN=
ENABLE_HTTPS=false
LETSENCRYPT_EMAIL=

# Mode akses:
#   auto  = pakai Nginx host bila port 80 bebas. Bila port 80 sudah dipakai
#           Coolify/Traefik, aplikasi otomatis dibuka langsung di APP_PORT.
#   true  = paksa Nginx host di port 80/443.
#   false = tanpa Nginx host; akses http://host:8080.
EDGE_PROXY=auto

# Dipakai bila DOMAIN kosong. Kosong = skrip mendeteksi IP publik otomatis.
# Jika server berada di balik NAT, isi dengan IP/host yang bisa diakses browser.
PUBLIC_HOST=

# --- Aplikasi ----------------------------------------------------------------
# local     : selalu bisa start, pembayaran Midtrans opsional.
# production: wajib MIDTRANS_SERVER_KEY produksi (Mid-server-...) dan JWT secret.
APP_ENV=local

# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@kawahputih.id

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=

# --- Database (kosong = dibuat otomatis) ------------------------------------
MYSQL_ROOT_PASSWORD=
DB_NAME=kawah_putih_db
DB_USER=kawahputih
DB_PASSWORD=

# --- JWT (kosong = dibuat otomatis) -----------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=KawahPutih

# --- Akun seed (kosong = dibuat otomatis dan ditampilkan di akhir) ----------
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_PETUGAS_PASSWORD=
SEED_RESET_STAFF_PASSWORD=false

# --- Opsi deploy -------------------------------------------------------------
# Dipakai hanya bila skrip dijalankan di luar folder projek.
# REPO_URL=https://github.com/hexaanugerah/booking_tiket.git
# APP_DIR=/opt/booking_tiket
# STOP_OLD_STACK=true
# ENABLE_UFW=true
# Port gateway/aplikasi di server (default 8080).
# APP_PORT=8080
